    <!-- JAVASCRIPT LOGIC & FIREBASE -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
        import { getDatabase, ref, onValue } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-database.js";

        // Konfigurasi Database Firebase (Harus Sama dengan Menu Utama)
        const firebaseConfig = {
            apiKey: "AIzaSyAVwQw-zBMEVbRaQc2lcWfdss3l2zOhoNs",
            authDomain: "pscp-ternate.firebaseapp.com",
            databaseURL: "https://pscp-ternate-default-rtdb.asia-southeast1.firebasedatabase.app",
            projectId: "pscp-ternate",
            storageBucket: "pscp-ternate.firebasestorage.app",
            messagingSenderId: "1057698178770",
            appId: "1:1057698178770:web:d4ed0a01f84d26603c2f0b"
        };
        
        const app = initializeApp(firebaseConfig);
        const database = getDatabase(app);
        const dbRef = ref(database, 'pencak_scoring_state');

        let juaraPeserta = [];
        let listKontingen = [];
        let listPesilatDetail = [];

        // Variabel Pagination
        let currentPage = 1;
        const itemsPerPage = 20;

        // Tab Switch Logic
        window.switchTab = function(tab) {
            document.getElementById('view-peserta').classList.toggle('hidden', tab !== 'peserta');
            document.getElementById('view-kontingen').classList.toggle('hidden', tab !== 'kontingen');
            document.getElementById('view-detail').classList.toggle('hidden', tab !== 'detail');
            
            document.getElementById('tab-peserta').classList.toggle('active', tab === 'peserta');
            document.getElementById('tab-kontingen').classList.toggle('active', tab === 'kontingen');
            document.getElementById('tab-detail').classList.toggle('active', tab === 'detail');
        }

        // Listener Real-time Database
        onValue(dbRef, (snapshot) => {
            const data = snapshot.val();
            if (data) {
                processRekapitulasi(data.matches || [], data.participants || []);
            }
        });

        function processRekapitulasi(matches, participants) {
            juaraPeserta = [];
            let kontingenStats = {};
            let pesilatStats = {}; // Penyimpanan akumulasi HANYA untuk pesilat terdaftar
            
            // 1. Inisialisasi HANYA Data Peserta Terdaftar
            participants.forEach(p => {
                let nama = (p.nama || p.name || '').toUpperCase().trim();
                let k = (p.kont || '').toUpperCase().trim();
                
                // Set awal stats Detail Pesilat (Syarat Wajib Terdaftar)
                if(nama) {
                    pesilatStats[nama] = {
                        nama: nama,
                        kont: k,
                        pukulan: 0, tendangan: 0, jatuhan: 0,
                        binaan: 0, teguran: 0, peringatan: 0,
                        totalPoin: 0, totalPinalty: 0
                    };
                }

                // Kalkulasi total awal pendaftar Kontingen
                if(k) {
                    if(!kontingenStats[k]) {
                        kontingenStats[k] = { nama: k, totalPeserta: 0, emas: 0, perak: 0, perunggu: 0 };
                    }
                    kontingenStats[k].totalPeserta++;
                }
            });

            // 2. Kalkulasi Perolehan Medali & Kalkulasi Poin Pertandingan
            matches.forEach(m => {
                // A. BAGIAN MEDALI (Hanya pertandingan Selesai)
                if(m.status === 'selesai') {
                    let fase = (m.fase || '').toUpperCase().trim();
                    let wName = (m.winner || '').toUpperCase().trim();
                    let lName = m.winnerSide === 'biru' ? (m.m || '').toUpperCase().trim() : m.winnerSide === 'merah' ? (m.b || '').toUpperCase().trim() : '';
                    
                    let kat = `${m.kelas || ''} ${m.cat || ''} ${m.gender || ''}`.toUpperCase().trim();

                    if (fase === 'FINAL') {
                        // Pastikan Pemenang Emas adalah peserta terdaftar
                        if(wName && wName !== 'BYE' && wName !== 'KEPUTUSAN DEWAN' && pesilatStats[wName]) {
                            let kont = pesilatStats[wName].kont;
                            juaraPeserta.push({ nama: wName, kont: kont, kategori: kat, juara: 1, keterangan: 'Juara 1 (Emas)' });
                            if(kont) kontingenStats[kont].emas++;
                        }
                        // Pastikan Pemenang Perak adalah peserta terdaftar
                        if(lName && lName !== 'BYE' && lName !== 'KEPUTUSAN DEWAN' && pesilatStats[lName]) {
                            let kont = pesilatStats[lName].kont;
                            juaraPeserta.push({ nama: lName, kont: kont, kategori: kat, juara: 2, keterangan: 'Juara 2 (Perak)' });
                            if(kont) kontingenStats[kont].perak++;
                        }
                    } else if (fase === 'SEMI FINAL') {
                        // Pastikan Pemenang Perunggu adalah peserta terdaftar
                        if(lName && lName !== 'BYE' && lName !== 'KEPUTUSAN DEWAN' && pesilatStats[lName]) {
                            let kont = pesilatStats[lName].kont;
                            juaraPeserta.push({ nama: lName, kont: kont, kategori: kat, juara: 3, keterangan: 'Juara 3 Bersama (Perunggu)' });
                            if(kont) kontingenStats[kont].perunggu++;
                        }
                    }
                }

                // B. BAGIAN AKUMULASI POIN DETAIL PESILAT (Berjalan selama match/selesai)
                let mName = (m.m || '').toUpperCase().trim();
                let bName = (m.b || '').toUpperCase().trim();

                // Ekstraktor Universal
                const extractData = (matchData, side) => {
                    let p=0, t=0, j=0, b=0, tg=0, pr=0, tot=0, totP=0;
                    let prefix1 = side === 'merah' ? 'm' : 'b';
                    let prefix2 = side === 'merah' ? 'M' : 'B';

                    p += Number(matchData[`${prefix1}_pukulan`] || matchData[`pukulan${prefix2}`] || matchData[`pukulan_${side}`] || 0);
                    t += Number(matchData[`${prefix1}_tendangan`] || matchData[`tendangan${prefix2}`] || matchData[`tendangan_${side}`] || 0);
                    j += Number(matchData[`${prefix1}_jatuhan`] || matchData[`jatuhan${prefix2}`] || matchData[`jatuhan_${side}`] || 0);
                    b += Number(matchData[`${prefix1}_binaan`] || matchData[`binaan${prefix2}`] || matchData[`binaan_${side}`] || 0);
                    tg += Number(matchData[`${prefix1}_teguran`] || matchData[`teguran${prefix2}`] || matchData[`teguran_${side}`] || 0);
                    pr += Number(matchData[`${prefix1}_peringatan`] || matchData[`peringatan${prefix2}`] || matchData[`peringatan_${side}`] || 0);

                    ['r1','r2','r3'].forEach(r => {
                        if(matchData[r] && matchData[r][side]) {
                            p += Number(matchData[r][side].pukulan || 0);
                            t += Number(matchData[r][side].tendangan || 0);
                            j += Number(matchData[r][side].jatuhan || 0);
                            b += Number(matchData[r][side].binaan || 0);
                            tg += Number(matchData[r][side].teguran || 0);
                            pr += Number(matchData[r][side].peringatan || 0);
                        }
                    });

                    tot = Number(matchData[`total${prefix2}`] || matchData[`${prefix1}_total`] || matchData[`total_${side}`] || ((p*1) + (t*2) + (j*3)));
                    totP = b + tg + pr; 
                    return { p, t, j, b, tg, pr, tot, totP };
                };

                // INPUT POIN KE PESERTA (HANYA JIKA TERDAFTAR DI pesilatStats)
                if (mName && pesilatStats[mName]) {
                    let dM = extractData(m, 'merah');
                    pesilatStats[mName].pukulan += dM.p;
                    pesilatStats[mName].tendangan += dM.t;
                    pesilatStats[mName].jatuhan += dM.j;
                    pesilatStats[mName].binaan += dM.b;
                    pesilatStats[mName].teguran += dM.tg;
                    pesilatStats[mName].peringatan += dM.pr;
                    pesilatStats[mName].totalPoin += dM.tot;
                    pesilatStats[mName].totalPinalty += dM.totP;
                }
                
                if (bName && pesilatStats[bName]) {
                    let dB = extractData(m, 'biru');
                    pesilatStats[bName].pukulan += dB.p;
                    pesilatStats[bName].tendangan += dB.t;
                    pesilatStats[bName].jatuhan += dB.j;
                    pesilatStats[bName].binaan += dB.b;
                    pesilatStats[bName].teguran += dB.tg;
                    pesilatStats[bName].peringatan += dB.pr;
                    pesilatStats[bName].totalPoin += dB.tot;
                    pesilatStats[bName].totalPinalty += dB.totP;
                }
            });

            // 3. Sortir Data
            juaraPeserta.sort((a, b) => {
                let cKat = a.kategori.localeCompare(b.kategori);
                if(cKat !== 0) return cKat;
                return a.juara - b.juara;
            });

            listKontingen = Object.values(kontingenStats)
                .filter(k => k.emas > 0 || k.perak > 0 || k.perunggu > 0 || k.totalPeserta > 0)
                .sort((a, b) => {
                    if(b.emas !== a.emas) return b.emas - a.emas;
                    if(b.perak !== a.perak) return b.perak - a.perak;
                    if(b.perunggu !== a.perunggu) return b.perunggu - a.perunggu;
                    return b.totalPeserta - a.totalPeserta;
                });

            // Sortir Detail Statistik Pesilat (Poin Descending -> Pinalty Ascending)
            listPesilatDetail = Object.values(pesilatStats).sort((a, b) => {
                if(b.totalPoin !== a.totalPoin) return b.totalPoin - a.totalPoin;
                return a.totalPinalty - b.totalPinalty; 
            });

            // Pastikan page tidak out of bounds setelah update data
            const totalPages = Math.ceil(listPesilatDetail.length / itemsPerPage);
            if(currentPage > totalPages && totalPages > 0) currentPage = totalPages;
            if(currentPage < 1) currentPage = 1;

            renderTables();
        }

        function renderTables() {
            // ============== RENDER TABEL PESERTA ==============
            let htmlPeserta = '';
            let pdfHtmlPeserta = '';
            if(juaraPeserta.length === 0) {
                htmlPeserta = `<tr><td colspan="4" class="p-8 text-center text-slate-400 italic text-[10px] font-bold uppercase">Belum ada hasil partai final / semifinal yang diselesaikan.</td></tr>`;
                pdfHtmlPeserta = `<tr><td colspan="4">Belum ada data.</td></tr>`;
            } else {
                juaraPeserta.forEach((p, idx) => {
                    let color = p.juara === 1 ? 'text-yellow-700 bg-yellow-100 border border-yellow-200' : p.juara === 2 ? 'text-slate-700 bg-slate-200 border border-slate-300' : 'text-orange-800 bg-orange-100 border border-orange-200';
                    let icon = p.juara === 1 ? '🥇' : p.juara === 2 ? '🥈' : '🥉';
                    
                    htmlPeserta += `
                    <tr class="border-b border-slate-100 hover:bg-amber-50/30 transition-all">
                        <td class="p-3 border-r border-slate-50 text-center font-black">${idx + 1}</td>
                        <td class="p-3 border-r border-slate-50">
                            <div class="font-black text-[11px] sm:text-[12px] text-slate-800 uppercase">${p.nama}</div>
                            <div class="text-[8px] sm:text-[9px] text-slate-500 uppercase font-bold tracking-tight">${p.kont}</div>
                        </td>
                        <td class="p-3 border-r border-slate-50 uppercase text-center font-black text-indigo-700 text-[9px] sm:text-[10px]">${p.kategori}</td>
                        <td class="p-3 text-center">
                            <span class="${color} px-3 py-1.5 rounded-lg font-black text-[9px] sm:text-[10px] uppercase whitespace-nowrap shadow-sm">
                                ${icon} ${p.keterangan}
                            </span>
                        </td>
                    </tr>`;
                    
                    pdfHtmlPeserta += `
                    <tr>
                        <td>${idx + 1}</td>
                        <td style="text-align: left;"><b>${p.nama}</b><br><span style="font-size: 8px; color: #555;">${p.kont}</span></td>
                        <td>${p.kategori}</td>
                        <td style="font-weight: bold;">${p.keterangan}</td>
                    </tr>`;
                });
            }
            document.getElementById('tbody-peserta').innerHTML = htmlPeserta;
            document.getElementById('pdf-tbody-peserta').innerHTML = pdfHtmlPeserta;
            document.getElementById('count-peserta').innerText = `TOTAL: ${juaraPeserta.length}`;
            
            // ============== RENDER TABEL KONTINGEN ==============
            let htmlKontingen = '';
            let pdfHtmlKontingen = '';
            if(listKontingen.length === 0) {
                htmlKontingen = `<tr><td colspan="6" class="p-8 text-center text-slate-400 italic text-[10px] font-bold uppercase">Data kontingen belum tersedia.</td></tr>`;
                pdfHtmlKontingen = `<tr><td colspan="6">Belum ada data.</td></tr>`;
            } else {
                listKontingen.forEach((k, idx) => {
                    let rankClass = idx === 0 ? 'bg-yellow-400 text-yellow-900 border-yellow-500' : idx === 1 ? 'bg-slate-300 text-slate-800 border-slate-400' : idx === 2 ? 'bg-orange-300 text-orange-900 border-orange-400' : 'bg-slate-100 text-slate-600 border-slate-200';
                    
                    htmlKontingen += `
                    <tr class="border-b border-slate-100 hover:bg-amber-50/30 transition-all">
                        <td class="p-3 border-r border-slate-50 text-center">
                            <span class="${rankClass} border w-7 h-7 sm:w-8 sm:h-8 inline-flex items-center justify-center rounded-xl font-black text-[10px] sm:text-xs shadow-sm">${idx + 1}</span>
                        </td>
                        <td class="p-3 border-r border-slate-50 text-left font-black text-[10px] sm:text-xs text-slate-800 uppercase tracking-tight">${k.nama}</td>
                        <td class="p-3 border-r border-slate-50 text-center text-slate-500 font-bold">${k.totalPeserta}</td>
                        <td class="p-3 border-r border-slate-50 text-center font-black text-yellow-700 bg-yellow-50/80">${k.emas}</td>
                        <td class="p-3 border-r border-slate-50 text-center font-black text-slate-700 bg-slate-100/80">${k.perak}</td>
                        <td class="p-3 text-center font-black text-orange-800 bg-orange-50/80">${k.perunggu}</td>
                    </tr>`;
                    
                    pdfHtmlKontingen += `
                    <tr>
                        <td>${idx + 1}</td>
                        <td style="text-align: left; font-weight: bold;">${k.nama}</td>
                        <td>${k.totalPeserta}</td>
                        <td style="font-weight: bold; background-color: #fef08a;">${k.emas}</td>
                        <td style="font-weight: bold; background-color: #e2e8f0;">${k.perak}</td>
                        <td style="font-weight: bold; background-color: #fed7aa;">${k.perunggu}</td>
                    </tr>`;
                });
            }
            document.getElementById('tbody-kontingen').innerHTML = htmlKontingen;
            document.getElementById('pdf-tbody-kontingen').innerHTML = pdfHtmlKontingen;
            document.getElementById('count-kontingen').innerText = `TOTAL KONTINGEN: ${listKontingen.length}`;

            // ============== RENDER TABEL DETAIL PESILAT (PAGINATED UI) ==============
            let htmlDetail = '';
            
            if(listPesilatDetail.length === 0) {
                htmlDetail = `<tr><td colspan="7" class="p-8 text-center text-slate-400 italic text-[10px] font-bold uppercase border border-slate-300">Data pesilat belum tersedia.</td></tr>`;
                document.getElementById('pagination-controls').innerHTML = '';
            } else {
                // UI Pagination Calculation
                const startIndex = (currentPage - 1) * itemsPerPage;
                const endIndex = startIndex + itemsPerPage;
                const paginatedData = listPesilatDetail.slice(startIndex, endIndex);

                // Render Hanya Halaman Saat ini ke Layar
                paginatedData.forEach((p, relativeIdx) => {
                    let actualIdx = startIndex + relativeIdx + 1; // Menjaga Nomor urut asli
                    htmlDetail += `
                    <tr class="hover:bg-slate-50 transition-all">
                        <td class="p-2 border-2 border-slate-300 text-center text-[10px] sm:text-xs">${actualIdx}</td>
                        <td class="p-2 border-2 border-slate-300 text-left font-black text-[11px] sm:text-xs text-slate-800 uppercase">${p.nama}</td>
                        <td class="p-2 border-2 border-slate-300 text-slate-500 uppercase text-[9px] sm:text-[10px]">${p.kont}</td>
                        <td class="p-2 border-2 border-slate-300 text-blue-700 tracking-widest font-black bg-blue-50/50">(${p.pukulan}, ${p.tendangan}, ${p.jatuhan})</td>
                        <td class="p-2 border-2 border-slate-300 text-red-600 tracking-widest font-black bg-red-50/50">(${p.binaan}x, ${p.teguran}x, ${p.peringatan}x)</td>
                        <td class="p-2 border-2 border-slate-300 text-emerald-700 font-black text-sm bg-emerald-50/50">${p.totalPoin}</td>
                        <td class="p-2 border-2 border-slate-300 text-rose-800 font-black text-sm bg-rose-50/50">${p.totalPinalty}</td>
                    </tr>`;
                });

                // Generate Tombol Pagination
                generatePaginationControls(listPesilatDetail.length);
            }
            document.getElementById('tbody-detail').innerHTML = htmlDetail;
            document.getElementById('count-detail').innerText = `TOTAL PESERTA: ${listPesilatDetail.length}`;

            // ============== RENDER TABEL DETAIL PDF (FULL DATA - NON PAGINATION) ==============
            let pdfHtmlDetail = '';
            if (listPesilatDetail.length === 0) {
                 pdfHtmlDetail = `<tr><td colspan="7">Belum ada data.</td></tr>`;
            } else {
                // PDF Harus Mencetak SEMUA Data (Tidak di-slice)
                listPesilatDetail.forEach((p, idx) => {
                    pdfHtmlDetail += `
                    <tr>
                        <td>${idx + 1}</td>
                        <td style="text-align: left;"><b>${p.nama}</b></td>
                        <td style="font-size: 8px;">${p.kont}</td>
                        <td>(${p.pukulan}, ${p.tendangan}, ${p.jatuhan})</td>
                        <td>(${p.binaan}x, ${p.teguran}x, ${p.peringatan}x)</td>
                        <td style="font-weight: bold; background-color: #d1fae5;">${p.totalPoin}</td>
                        <td style="font-weight: bold; background-color: #ffe4e6;">${p.totalPinalty}</td>
                    </tr>`;
                });
            }
            document.getElementById('pdf-tbody-detail').innerHTML = pdfHtmlDetail;
        }

        // FUNGSI MEMBUAT TOMBOL PAGINATION
        function generatePaginationControls(totalItems) {
            const totalPages = Math.ceil(totalItems / itemsPerPage);
            let controlsDiv = document.getElementById('pagination-controls');
            
            if (totalPages <= 1) {
                controlsDiv.innerHTML = '';
                return;
            }

            let html = '';
            
            // Tombol Prev
            html += `<button onclick="changePage(${currentPage - 1})" class="page-btn" ${currentPage === 1 ? 'disabled' : ''}>
                        <i class="fas fa-chevron-left"></i> Prev
                     </button>`;

            // Angka Halaman (Max 5 angka disekitar current page agar tidak kepanjangan di HP)
            let startPage = Math.max(1, currentPage - 2);
            let endPage = Math.min(totalPages, startPage + 4);
            
            if (endPage - startPage < 4) {
                startPage = Math.max(1, endPage - 4);
            }

            if (startPage > 1) {
                html += `<button onclick="changePage(1)" class="page-btn">1</button>`;
                if (startPage > 2) html += `<span class="px-1 text-slate-400 font-bold">...</span>`;
            }

            for (let i = startPage; i <= endPage; i++) {
                html += `<button onclick="changePage(${i})" class="page-btn ${currentPage === i ? 'active' : ''}">${i}</button>`;
            }

            if (endPage < totalPages) {
                if (endPage < totalPages - 1) html += `<span class="px-1 text-slate-400 font-bold">...</span>`;
                html += `<button onclick="changePage(${totalPages})" class="page-btn">${totalPages}</button>`;
            }

            // Tombol Next
            html += `<button onclick="changePage(${currentPage + 1})" class="page-btn" ${currentPage === totalPages ? 'disabled' : ''}>
                        Next <i class="fas fa-chevron-right"></i>
                     </button>`;

            controlsDiv.innerHTML = html;
        }

        // FUNGSI GANTI HALAMAN
        window.changePage = function(page) {
            currentPage = page;
            renderTables();
            // Scroll sedikit ke atas agar nyaman di HP
            document.getElementById('view-detail').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        // FUNGSI EKSPOR PDF
        window.exportToPDF = function() {
            const element = document.getElementById('pdf-content');
            document.getElementById('pdf-timestamp').innerText = "WAKTU CETAK: " + new Date().toLocaleString('id-ID');
            
            const opt = { 
                margin: 10, 
                filename: 'Laporan_Rekapitulasi_Digital_Scoring.pdf', 
                image: { type: 'jpeg', quality: 0.98 }, 
                html2canvas: { scale: 2, useCORS: true }, 
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' } 
            };
            
            html2pdf().set(opt).from(element).save();
        }
    </script>
</body>
</html>
